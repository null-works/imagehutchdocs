ServerSignature Off
Options -Indexes
Options -MultiViews
# CORS header (avoids font rendering issues)(replace dev\.local with your domain\.com)
# SetEnvIf Origin ^(https?://.+\.dev\.local(?::\d{1,5})?)$   CORS_ALLOW_ORIGIN=$1
# Header append Access-Control-Allow-Origin  %{CORS_ALLOW_ORIGIN}e   env=CORS_ALLOW_ORIGIN
# Header merge  Vary "Origin"
<FilesMatch "\.htaccess|LICENSE">
	Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
	RewriteEngine On
	# If you have problems with the rewrite rules remove the "#" from the following RewriteBase line
	# You will also have to change the path to reflect the path to your Chevereto installation
	# Bypass rewrite rules for assign_images applet
	RewriteCond %{REQUEST_URI} ^/assign_images\.php$
	RewriteRule . - [L]

	# Redirect missing local images to external R2 storage
	RewriteRule ^/?images/(.+)$ https://media.imagehut.ch/images/$1 [R=301,NC,L]

	# Randomizer
	RewriteRule ^randomizer/(.+)\.gif$ http://%{HTTP_HOST}/i/?album=$1 [R=301,L]

	# PHP front controller
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . index.php [L]

	# Single PHP-entrypoint
	RewriteCond %{THE_REQUEST} ^.+?\ [^?]+\.php[?\ ] [NC]
	RewriteCond %{REQUEST_URI} !^/assign_images\.php$
	RewriteRule \.php$ - [NC,L,F,R=404]
</IfModule>
